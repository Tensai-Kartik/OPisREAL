# ==============================================================================
# OPisReal - Production Environment Variables for Vercel Deployment
# ==============================================================================

# Supabase Public URL and Public Anon Key
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Secret Service Role Key (Required for server-side verification and admin operations)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Game Session Encryption Key (Random secure string)
GAME_SECRET_KEY=op-is-real-secret-game-key-2026

# Admin Dashboard Password 
ADMIN_PASSWORD=your-password

# Production URL
NEXT_PUBLIC_SITE_URL=https://op-is-real.vercel.app
